	C [label="Fluid Streamlines are Constricted"]
	D [label="Flow Speed ($v$) Accelerates (Increased Kinetic Energy)"]
	E [label="Inverse Relationship: As Kinetic Energy Increases..."]
	F [label="Static Pressure ($P$) Must Decrease"]
	G [label="Bernoulli Effect Demonstrated: High Speed $\rightarrow$ Low Pressure"]
	A -> B [label="Governs the Energy Balance"]
	B -> C [label="Leads to the analysis of flow regions"]
	C -> D [label="Effect of Constriction"]
	D -> E [label="Leads to the consequence"]
	E -> F [label="To maintain constant Total Energy (from B)"]
	F -> G [label="Resulting Phenomenon"]
}
